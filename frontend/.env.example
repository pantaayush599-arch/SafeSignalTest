VITE_API_BASE_URL=http://127.0.0.1:8000

# Firebase Authentication (phone OTP + Google Sign-In). Leave unset to run
# without real Firebase -- the login page falls back to the demo persona
# picker, which is the only path this sandbox has been tested against since
# no real Firebase project is available here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
